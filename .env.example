# Required for hosted deployments. There is no default admin PIN.
# Generate a strong value and provide it through the environment or local secrets store.
ADMIN_PIN=

# Bind local desktop installs only to loopback. Use 0.0.0.0 only behind an authenticated HTTPS proxy.
HOST=127.0.0.1
PORT=3000

# Optional AI integration.
GEMINI_API_KEY=

# Set to 1 to prevent the executable from opening a browser automatically.
NO_AUTO_OPEN=0
